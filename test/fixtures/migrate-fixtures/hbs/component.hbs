<h2>{{component.name}}</h2>
{{#if component.description}}
    <p>{{parseDescription component.description}}</p>
{{/if}}
{{#if component.selector}}
    <p><b>Selector:</b> <code>{{component.selector}}</code></p>
{{/if}}
{{#if component.methodsClass.length}}
    <h3>Methods</h3>
    <ul>
        {{#each component.methodsClass}}
            <li><code>{{name}}</code> {{#if returnType}}— returns {{linkType returnType}}{{/if}}</li>
        {{/each}}
    </ul>
{{/if}}
